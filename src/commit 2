#include <iostream>
#include <vector>
#include <random>

using namespace std;

// F1: 이치방쿠지 한 세트 구성 (총 80개 기준)
struct PrizePool {
    int total_tickets = 80;
    vector<int> counts = { 2, 3, 5, 10, 20, 40 };
    int price_per_ticket = 8000;
};

vector<int> create_ticket_box(const PrizePool& pool) {
    vector<int> tickets;
    tickets.reserve(pool.total_tickets);
    for (size_t i = 0; i < pool.counts.size(); ++i) {
        for (int c = 0; c < pool.counts[i]; ++c) {
            tickets.push_back(static_cast<int>(i));
        }
    }
    return tickets;
}

// F2: 난수 기반 비복원 추출 엔진 (A상 당첨 시까지 반복)
int simulate_one_round(mt19937& gen, const PrizePool& pool) {
    vector<int> tickets = create_ticket_box(pool);
    int attempts = 0;

    while (!tickets.empty()) {
        uniform_int_distribution<size_t> dist(0, tickets.size() - 1);
        size_t index = dist(gen);
        attempts++;

        if (tickets[index] == 0) { break; } // A상(0번) 당첨 시 종료
        tickets.erase(tickets.begin() + index); // 비복원 추출 (뽑은 종이 제거)
    }
    return attempts;
}

int main() {
    PrizePool pool;
    random_device rd;
    mt19937 gen(rd());

    int single_run = simulate_one_round(gen, pool);
    cout << "[F2] Single round test - Attempts for A Prize: " << single_run << endl;
    return 0;
}
