#include <iostream>
#include <vector>
#include <random>

using namespace std;

struct PrizePool {
    int total_tickets = 80;
    vector<int> counts = { 2, 3, 5, 10, 20, 40 };
    int price_per_ticket = 8000;
};

// 단일 라운드 시뮬레이션 함수 (비복원 추출)
int simulate_one_round(mt19937& gen, const PrizePool& pool) {
    vector<int> tickets;
    tickets.reserve(pool.total_tickets);

    for (size_t i = 0; i < pool.counts.size(); ++i) {
        for (int c = 0; c < pool.counts[i]; ++c) {
            tickets.push_back(static_cast<int>(i));
        }
    }

    int attempts = 0;
    while (!tickets.empty()) {
        uniform_int_distribution<size_t> dist(0, tickets.size() - 1);
        size_t index = dist(gen);
        attempts++;

        if (tickets[index] == 0) { break; } // A상 당첨 시 종료

        tickets.erase(tickets.begin() + index); // 비복원 추출 (제거)
    }
    return attempts;
}

int main() {
    PrizePool pool;
    random_device rd;
    mt19937 gen(rd());

    int test_att = simulate_one_round(gen, pool);
    cout << "Test simulation attempts to get A prize: " << test_att << endl;
    return 0;
}
